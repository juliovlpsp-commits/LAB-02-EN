@startuml CoISA Lab02 EN
' Lab02 - Stages 2 and 4 (UFCG) - English Version
' Render at https://plantuml.com/plantuml or export to png
left to right direction
skinparam classAttributeIconSize 0

class Rest {
  - restHours : int
  - weeks : int
  + Rest()
  + setRestHours(value: int) : void
  + setWeeks(value: int) : void
  + getStatus() : String
}

class OnlineTime {
  - courseName : String
  - expectedTime : int
  - spentTime : int
  + OnlineTime(courseName: String)
  + OnlineTime(courseName: String, expectedTime: int)
  + addOnlineTime(time: int) : void
  + reachedGoal() : boolean
  + toString() : String
}

class Course {
  - courseName : String
  - hours : int
  - grades : double[]
  - weights : int[]
  + Course(courseName: String)
  + Course(courseName: String, numGrades: int)
  + Course(courseName: String, numGrades: int, weights: int[])
  + addHours(hours: int) : void
  + addGrade(grade: int, value: double) : void
  - getAverage() : double
  + isApproved() : boolean
  + toString() : String
}

class Summary {
  - topic : String
  - content : String
  + Summary(topic: String, content: String)
  + getTopic() : String
  + getContent() : String
  + toString() : String
}

class SummaryRegistry {
  - summaries : Summary[]
  - count : int
  - currentPos : int
  + SummaryRegistry(capacity: int)
  + addSummary(topic: String, content: String) : void
  + getSummaries() : String[]
  + countSummaries() : int
  + printSummaries() : String
  + hasSummary(topic: String) : boolean
  + search(keyword: String) : String[]
}

class CoISA {
  + main(args: String[]) : void
  + testRest() : void
  - testOnlineTime() : void
  - testCourse() : void
  - testSummaries() : void
}

SummaryRegistry "1" *-- "0..*" Summary : contains >
CoISA ..> Rest : uses
CoISA ..> OnlineTime : uses
CoISA ..> Course : uses
CoISA ..> SummaryRegistry : uses

note right of SummaryRegistry
  Circular buffer: when full
  overwrites oldest entry.
  Duplicate topic is ignored.
  search() is case-insensitive
  and returns sorted.
end note

note right of Course
  Stage 4: weighted average
  if weights != null
  else arithmetic average
end note
@enduml
